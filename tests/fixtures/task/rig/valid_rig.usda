#usda 1.0
(
    defaultPrim = "Rig"
    upAxis = "Y"
)

def Xform "Rig" {
    def SkelRoot "SkelRoot" {
        def Skeleton "Skeleton" {
            uniform token[] joints = ["root", "root/spine01", "root/spine01/chest", "root/spine01/chest/neck_base", "root/spine01/chest/neck_base/head_base"]
        }
    }
}
